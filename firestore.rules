rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Los datos de usuario solo son accesibles desde su UID autenticado.
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Mantiene campos y valores alineados con TaskModel y los formularios.
    function validTask(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'category',
          'priority',
          'dueDate',
          'isCompleted',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'category',
          'priority',
          'dueDate',
          'isCompleted',
          'recurrence',
          'recurrenceDay',
          'subtasks',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 4000
        && data.category in ['Personal', 'Estudio', 'Trabajo', 'Otras']
        && data.priority in ['Alta', 'Media', 'Baja']
        && (data.dueDate == null || data.dueDate is timestamp)
        && data.isCompleted is bool
        && (!data.keys().hasAny(['recurrence'])
          || (data.recurrence in ['none', 'daily', 'weekly', 'monthly']
            && (data.recurrence == 'none' || data.dueDate is timestamp)))
        && (!data.keys().hasAny(['recurrenceDay'])
          || (data.recurrenceDay == null
            || (data.recurrenceDay is int
              && data.recurrenceDay >= 1
              && data.recurrenceDay <= 31)))
        && (!data.keys().hasAny(['subtasks'])
          || (data.subtasks is list && data.subtasks.size() <= 20))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/tasks/{taskId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId)
        && validTask(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(userId)
        && validTask(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
